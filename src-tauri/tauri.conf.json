{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DimSense",
  "version": "0.1.0",
  "identifier": "io.dimsense.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:8000",
    "beforeDevCommand": null,
    "beforeBuildCommand": "npm run build --prefix frontend"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "DimSense",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/dimsense-backend"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
